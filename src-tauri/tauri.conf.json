{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAOTUN",
  "version": "5.3.2",
  "identifier": "com.metehan.maotun",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MAOTUN // Küresel Sinyal & Canlı Dünya Konsolu",
        "width": 1520,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "backgroundColor": "#05070A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
